<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <ClipScopeGeneratedManifest>$(MSBuildProjectDirectory)/obj/ClipScope.$(ClipScopeVersion).manifest</ClipScopeGeneratedManifest>
    <ApplicationManifest>$(ClipScopeGeneratedManifest)</ApplicationManifest>
    <ApplicationIcon>Assets/ClipScope.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <Target Name="GenerateVersionedApplicationManifest" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj" />
    <Copy SourceFiles="app.manifest" DestinationFiles="$(ClipScopeGeneratedManifest)" />
    <XmlPoke XmlInputPath="$(ClipScopeGeneratedManifest)" Query="/a:assembly/a:assemblyIdentity/@version" Value="$(AssemblyVersion)" Namespaces="&lt;Namespace Prefix='a' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;" />
  </Target>
  <!-- The UI is constructed in C#, so PRI detection based on XAML Page items
       does not reliably add the application's merged index during dotnet publish.
       Native framework PRI files alone cannot initialize XamlControlsResources. -->
  <Target Name="PublishApplicationResourceIndex" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="GenerateProjectPriFile" Condition="'$(AppxGeneratePriEnabled)' == 'true'">
    <Error Condition="'$(ProjectPriFullPath)' == '' or !Exists('$(ProjectPriFullPath)')"
           Text="The application WinUI resource index must be generated before publication." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish->WithMetadataValue('RelativePath', '$(ProjectPriFileName)'))" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Update="Assets/ClipScope.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../ClipScope.Windows/ClipScope.Windows.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>
</Project>
